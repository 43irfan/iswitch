# Copy values into apps/api/.env (and web env as noted).

# --- App / API ---
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- PostgreSQL (App DB — source of truth) ---
# Local Postgres: database=iswitch, user/pass=postgres/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iswitch?schema=public

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Asterisk (Phase 1 stubs — fill when voice server is ready) ---
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USER=iswitch
ASTERISK_ARI_PASSWORD=change-me
ASTERISK_ARI_APP=iswitch
ASTERISK_AMI_HOST=127.0.0.1
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USER=iswitch
ASTERISK_AMI_PASSWORD=change-me

# --- Next.js (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
