generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  RESELLER
  RETAIL_CUSTOMER_ADMIN
  WHOLESALE_CUSTOMER
  END_USER
}

enum AccountType {
  PLATFORM
  RESELLER
  RETAIL
  WHOLESALE
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum SyncStatus {
  PENDING
  SYNCED
  ERROR
  SKIPPED
}

enum DidDestinationType {
  EXTENSION
  RING_GROUP
  QUEUE
  IVR
  EXTERNAL
  VOICEMAIL
}

enum RingStrategy {
  RINGALL
  LEASTRECENT
  FEWESTCALLS
  RANDOM
  RRMEMORY
}

enum BillingMode {
  PREPAID
  POSTPAID
}

enum TrunkAuthType {
  USERPASS
  IP_ACL
  BOTH
}

model Account {
  id                 String           @id @default(cuid())
  name               String
  type               AccountType
  status             AccountStatus    @default(ACTIVE)
  parentId           String?
  parent             Account?         @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]        @relation("AccountTree")
  users              User[]
  extensions         Extension[]
  dids               Did[]
  ringGroups         RingGroup[]
  queues             CallQueue[]
  ivrMenus           IvrMenu[]
  voicemails         VoicemailBox[]
  customerTrunks     CustomerTrunk[]
  carrierTrunks      CarrierTrunk[]
  routePrefixes      RoutePrefix[]
  cdrs               Cdr[]
  ledgerEntries      BalanceLedger[]
  /// Money in micros (1 USD = 1_000_000). Never use floats.
  balanceMicros      BigInt           @default(0)
  creditLimitMicros  BigInt           @default(0)
  billingMode        BillingMode      @default(PREPAID)
  /// Fallback outbound rate for retail (micros per minute)
  defaultRateMicros  BigInt           @default(10000)
  maxChannels        Int              @default(0)
  maxCps             Int              @default(0)
  techPrefix         String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([parentId])
  @@index([type])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  role         UserRole
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id])
  isActive     Boolean     @default(true)
  sessions     Session[]
  extensions   Extension[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([accountId])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Extension {
  id               String           @id @default(cuid())
  accountId        String
  account          Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  number           String
  displayName      String?
  sipUsername      String
  sipPassword      String
  callerId         String?
  dnd              Boolean          @default(false)
  forwardTo        String?
  voicemailEnabled Boolean          @default(true)
  userId           String?
  user             User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  voicemailBox     VoicemailBox?
  ringGroupMembers RingGroupMember[]
  queueMembers     QueueMember[]
  syncStatus       SyncStatus       @default(PENDING)
  syncError        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([accountId, number])
  @@unique([accountId, sipUsername])
  @@index([accountId])
  @@index([userId])
}

model Did {
  id              String             @id @default(cuid())
  accountId       String
  account         Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  number          String
  description     String?
  destinationType DidDestinationType
  /// Target id for EXTENSION / RING_GROUP / QUEUE / IVR / VOICEMAIL, or external number string
  destinationRef  String
  callerIdName    String?
  enabled         Boolean            @default(true)
  syncStatus      SyncStatus         @default(PENDING)
  syncError       String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([number])
  @@index([accountId])
}

model RingGroup {
  id         String            @id @default(cuid())
  accountId  String
  account    Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  strategy   RingStrategy      @default(RINGALL)
  ringTimeout Int              @default(20)
  members    RingGroupMember[]
  syncStatus SyncStatus        @default(PENDING)
  syncError  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

model RingGroupMember {
  id          String    @id @default(cuid())
  ringGroupId String
  ringGroup   RingGroup @relation(fields: [ringGroupId], references: [id], onDelete: Cascade)
  extensionId String
  extension   Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  priority    Int       @default(1)

  @@unique([ringGroupId, extensionId])
}

model CallQueue {
  id          String        @id @default(cuid())
  accountId   String
  account     Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name        String
  extension   String?
  strategy    RingStrategy  @default(RINGALL)
  timeout     Int           @default(30)
  musicOnHold String        @default("default")
  members     QueueMember[]
  syncStatus  SyncStatus    @default(PENDING)
  syncError   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

model QueueMember {
  id         String    @id @default(cuid())
  queueId    String
  queue      CallQueue @relation(fields: [queueId], references: [id], onDelete: Cascade)
  extensionId String
  extension  Extension @relation(fields: [extensionId], references: [id], onDelete: Cascade)
  penalty    Int       @default(0)

  @@unique([queueId, extensionId])
}

model IvrMenu {
  id             String     @id @default(cuid())
  accountId      String
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  greetingPrompt String     @default("welcome")
  timeoutSeconds Int        @default(5)
  /// Digits map: { "1": { "type": "EXTENSION", "ref": "..." }, ... }
  options        Json       @default("{}")
  syncStatus     SyncStatus @default(PENDING)
  syncError      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

model VoicemailBox {
  id          String     @id @default(cuid())
  accountId   String
  account     Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mailbox     String
  pin         String     @default("0000")
  email       String?
  extensionId String?    @unique
  extension   Extension? @relation(fields: [extensionId], references: [id], onDelete: SetNull)
  syncStatus  SyncStatus @default(PENDING)
  syncError   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([accountId, mailbox])
  @@index([accountId])
}

model SyncAudit {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  status     String
  message    String?
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

/// Wholesale customer SIP trunk (inbound from customer PBX / outbound auth)
model CustomerTrunk {
  id           String       @id @default(cuid())
  accountId    String
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name         String
  authType     TrunkAuthType @default(USERPASS)
  sipUsername  String?
  sipPassword  String?
  /// Comma-separated IP/CIDR allow list
  ipAcl        String?
  techPrefix   String?
  maxChannels  Int          @default(10)
  maxCps       Int          @default(5)
  enabled      Boolean      @default(true)
  syncStatus   SyncStatus   @default(PENDING)
  syncError    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
  @@index([sipUsername])
}

/// Upstream carrier / vendor trunk
model CarrierTrunk {
  id             String     @id @default(cuid())
  /// Owning platform or reseller account that manages this carrier
  accountId      String
  account        Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  host           String
  port           Int        @default(5060)
  sipUsername    String?
  sipPassword    String?
  codecs         String     @default("ulaw,alaw")
  maxChannels    Int        @default(100)
  maxCps         Int        @default(50)
  enabled        Boolean    @default(true)
  priority       Int        @default(100)
  syncStatus     SyncStatus @default(PENDING)
  syncError      String?
  routes         RoutePrefix[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@unique([accountId, name])
  @@index([accountId])
}

/// Prefix route with rate (micros per minute) toward a carrier
model RoutePrefix {
  id              String       @id @default(cuid())
  accountId       String
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  prefix          String
  description     String?
  carrierTrunkId  String
  carrierTrunk    CarrierTrunk @relation(fields: [carrierTrunkId], references: [id], onDelete: Cascade)
  /// Sell rate to wholesale customer (micros per minute)
  rateMicros      BigInt       @default(0)
  /// Cost from carrier (micros per minute)
  costMicros      BigInt       @default(0)
  priority        Int          @default(100)
  enabled         Boolean      @default(true)
  syncStatus      SyncStatus   @default(PENDING)
  syncError       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([accountId, prefix, carrierTrunkId])
  @@index([accountId, prefix])
  @@index([carrierTrunkId])
}

enum CdrDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CdrStatus {
  RECEIVED
  RATED
  ERROR
  SKIPPED
}

model Cdr {
  id               String       @id @default(cuid())
  uniqueId         String       @unique
  accountId        String
  account          Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  direction        CdrDirection @default(OUTBOUND)
  caller           String
  callee           String
  startAt          DateTime?
  answerAt         DateTime?
  endAt            DateTime?
  billsec          Int          @default(0)
  disposition      String?
  customerTrunkId  String?
  carrierTrunkId   String?
  routePrefixId    String?
  rateMicros       BigInt?
  costMicros       BigInt?
  chargeMicros     BigInt       @default(0)
  status           CdrStatus    @default(RECEIVED)
  ratedAt          DateTime?
  errorMessage     String?
  raw              Json?
  ledger           BalanceLedger?
  createdAt        DateTime     @default(now())

  @@index([accountId, createdAt])
  @@index([status])
  @@index([callee])
}

model BalanceLedger {
  id                 String   @id @default(cuid())
  accountId          String
  account            Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cdrId              String?  @unique
  cdr                Cdr?     @relation(fields: [cdrId], references: [id], onDelete: SetNull)
  deltaMicros        BigInt
  balanceAfterMicros BigInt
  reason             String
  createdAt          DateTime @default(now())

  @@index([accountId, createdAt])
}

/// Block outbound prefixes (account-scoped or global when accountId is "")
model DestinationBlock {
  id        String   @id @default(cuid())
  accountId String   @default("")
  prefix    String
  reason    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, prefix])
  @@index([prefix])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorEmail  String?
  action      String
  entityType  String?
  entityId    String?
  ip          String?
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
}
